{
  "_hinweis": "Eine Quelle für Bereiche, Schritte und Standardwerte (Konzept A.4, F09 des Lernzentrums). Standardwerte = Aufgabe. kA in W/K; Zeiten in min; Mengen in ml; Masse in g.",
  "regler": [
    {"id": "tEnd",   "key": "tEnd_min",  "tex": "t_\\mathrm{Z}",               "einheit": "min", "min": 1,    "max": 180, "schritt": 1,    "standard": 60,  "stellen": 0, "gruppe": "pflicht",  "grundlage": "g_tEnd"},
    {"id": "VK",     "key": "VK_ml",     "tex": "V_\\mathrm{K}",               "einheit": "ml",  "min": 100,  "max": 400, "schritt": 10,   "standard": 200, "stellen": 0, "gruppe": "kaffee",   "grundlage": "g_aufgabe"},
    {"id": "thK0",   "key": "thK0",      "tex": "\\vartheta_\\mathrm{K,0}",    "einheit": "°C",  "min": 60,   "max": 95,  "schritt": 0.1,  "standard": 80,  "stellen": 1, "gruppe": "kaffee",   "grundlage": "g_thK0"},
    {"id": "VM",     "key": "VM_ml",     "tex": "V_\\mathrm{M}",               "einheit": "ml",  "min": 5,    "max": 100, "schritt": 5,    "standard": 30,  "stellen": 0, "gruppe": "milch",    "grundlage": "g_aufgabe"},
    {"id": "thM",    "key": "thM",       "tex": "\\vartheta_\\mathrm{M}",      "einheit": "°C",  "min": 2,    "max": 65,  "schritt": 0.5,  "standard": 5,   "stellen": 1, "gruppe": "milch",    "grundlage": "g_thM"},
    {"id": "thU",    "key": "thU",       "tex": "\\vartheta_\\mathrm{u}",      "einheit": "°C",  "min": 10,   "max": 30,  "schritt": 0.5,  "standard": 20,  "stellen": 1, "gruppe": "tasse",    "grundlage": "g_aufgabe"},
    {"id": "kA",     "key": "kA",        "tex": "kA",                          "einheit": "W/K", "min": 0.05, "max": 1.0, "schritt": 0.01, "standard": null, "stellen": 4, "gruppe": "tasse",   "grundlage": "g_kA"},
    {"id": "thMess", "key": "thMess",    "tex": "\\vartheta_\\mathrm{K}(10\\,\\mathrm{min})", "einheit": "°C", "min": 30, "max": 90, "schritt": 0.1, "standard": 67, "stellen": 1, "gruppe": "tasse", "grundlage": "g_aufgabe"},
    {"id": "mB",     "key": "mB_g",      "tex": "m_\\mathrm{B}",               "einheit": "g",   "min": 100,  "max": 600, "schritt": 10,   "standard": 300, "stellen": 0, "gruppe": "tasse",    "grundlage": "g_becher"},
    {"id": "kA1",    "key": "kA1Faktor", "tex": "kA_1/kA",                     "einheit": "%",   "min": 90,   "max": 110, "schritt": 1,    "standard": 100, "stellen": 0, "gruppe": "weitere",  "grundlage": "g_kA1", "faktor": 100}
  ],
  "schalter": [
    {"id": "milch2Raum", "standard": false, "gruppe": "milch"},
    {"id": "becher",     "standard": false, "gruppe": "tasse"}
  ]
}
